{{#if this.hasCustomFields}}
    {{#each this.customFieldGroups as |group|}}
        <ContentPanel @title={{group.name}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 lg:grid-cols-{{or group.meta.grid_size 2}} gap-2">
                {{#each group.customFields as |customField|}}
                    <CustomField::Input @customField={{customField}} @subject={{@draft.orderConfig}} @onChange={{@draft.customFields.setFieldValue}} />
                {{/each}}
            </div>
        </ContentPanel>
    {{/each}}
{{/if}}
