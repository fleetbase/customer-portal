<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @name={{t "portal.modals.reschedule.name"}} @helpText={{t "portal.modals.reschedule.help-text"}}>
            <DateTimeInput @value={{@options.reschedule.scheduled_at}} @onChange={{fn (mut @options.reschedule.scheduled_at)}} placeholder={{t "portal.modals.reschedule.placeholder"}} class="w-full form-input" />
        </InputGroup>
    </div>
</Modal::Default>

