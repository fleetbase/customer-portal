<div class="portal-dashboard-widget portal-kpi-tile portal-kpi-accent-amber" ...attributes>
    <div class="portal-kpi-content">
        <div class="min-w-0">
            <div class="portal-kpi-label">Open Tickets</div>
            {{#if this.load.isRunning}}
                <Spinner />
            {{else if this.error}}
                <div class="portal-widget-error">{{this.error}}</div>
            {{else}}
                <div class="portal-kpi-value">{{this.total}}</div>
            {{/if}}
        </div>
        <div class="portal-kpi-icon"><FaIcon @icon="headset" /></div>
    </div>
</div>
