<Portal::Container>
    <Portal::Main>
        <Portal::Sidebar>
            <BasicDropdown class="portal-user-menu" @renderInPlace={{true}} as |dd|>
                <dd.Trigger class="next-nav-item">
                    <div class="flex flex-row">
                        <div class="portal-user-avatar-container">
                            <Image
                                src={{this.currentUser.avatarUrl}}
                                @fallbackSrc="https://s3.ap-southeast-1.amazonaws.com/flb-assets/static/no-avatar.png"
                                alt={{this.currentUser.name}}
                                class="portal-user-avatar"
                            />
                        </div>
                        <div class="flex flex-col">
                            <div class="text-lg font-semibold">{{this.currentUser.name}}</div>
                            <div class="text-xs">{{this.currentUser.email}}</div>
                        </div>
                    </div>
                </dd.Trigger>
                <dd.Content>
                    <div class="next-dd-menu">
                        <div class="px-1">
                            <Layout::Sidebar::Item class="next-dd-item" @route="customer-portal.portal.account" @icon="gear">Account</Layout::Sidebar::Item>
                        </div>
                        <Layout::Header::DarkModeToggle />
                        <div class="next-dd-menu-seperator"></div>
                        <div class="px-1">
                            <Layout::Sidebar::Item class="next-dd-item" @onClick={{this.invalidateSession}} @icon="person-running">Logout</Layout::Sidebar::Item>
                        </div>
                    </div>
                </dd.Content>
            </BasicDropdown>
            <Layout::Sidebar::Item @route="customer-portal.portal.home" @icon="home">Dashboard</Layout::Sidebar::Item>
            <RegistryYield @type="menu" @registry="customer-portal:sidebar" as |menuItem|>
                <Layout::Sidebar::Item
                    @onClick={{fn this.universe.transitionMenuItem "customer-portal.portal.virtual" menuItem}}
                    @item={{menuItem}}
                    @icon={{menuItem.icon}}
                    @permission={{menuItem.permission}}
                >{{menuItem.title}}</Layout::Sidebar::Item>
            </RegistryYield>
        </Portal::Sidebar>
        <Portal::Section>{{outlet}}</Portal::Section>
    </Portal::Main>
    <Portal::Footer />
</Portal::Container>