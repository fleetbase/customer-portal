<Portal::ContentWrapper class="portal-page-card">
    <div class="portal-section-header">
        <div>
            <div class="portal-section-eyebrow">{{t "portal.notifications.eyebrow"}}</div>
            <h1>{{t "portal.notifications.title"}}</h1>
            <p>{{t "portal.notifications.subtitle"}}</p>
        </div>
    </div>
    <InfoBlock @type="info" @icon="circle-info" class="mt-4">
        {{t "portal.notifications.info-block"}}
    </InfoBlock>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mt-5">
        {{#each this.preferenceGroups as |group|}}
            <ContentPanel @title={{group.title}} @open={{true}} @wrapperClass="bordered-classic">
                <p class="portal-panel-copy">{{group.description}}</p>
                <div class="space-y-2">
                    {{#each group.items as |item|}}
                        <label class="portal-toggle-row">
                            <Input @type="checkbox" @checked={{item.enabled}} class="form-checkbox" {{on "change" (fn this.setPreference item.key)}} />
                            <span>{{item.label}}</span>
                        </label>
                    {{/each}}
                </div>
            </ContentPanel>
        {{/each}}
    </div>
    <div class="mt-4">
        <Button @type="primary" @icon="save" @text={{t "portal.notifications.save-button"}} @onClick={{perform this.savePreferences}} @isLoading={{this.savePreferences.isRunning}} />
    </div>
</Portal::ContentWrapper>

