<Portal::ContentWrapper class="portal-page-card portal-table-page-card">
    <div class="portal-section-header">
        <div>
            <div class="portal-section-eyebrow">{{t "portal.documents.eyebrow"}}</div>
            <h1>{{t "portal.documents.title"}}</h1>
            <p>{{t "portal.documents.subtitle"}}</p>
        </div>
    </div>
    <div class="next-table-wrapper no-scroll h-auto table-fluid portal-table-panel mt-5">
        <table class="table table-fixed portal-table">
            <thead>
                <tr>
                    <th class="text-left">{{t "portal.documents.table.document"}}</th>
                    <th class="text-left">{{t "portal.documents.table.type"}}</th>
                    <th class="text-left">{{t "portal.documents.table.order"}}</th>
                    <th class="text-left">{{t "portal.documents.table.created"}}</th>
                    <th class="text-right">{{t "portal.documents.table.actions"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.model.documents as |document|}}
                    <tr>
                        <td class="font-semibold">{{or document.original_filename document.name document.public_id}}</td>
                        <td>{{n-a (humanize document.type)}}</td>
                        <td>{{n-a (or document.order_tracking_number document.order_public_id)}}</td>
                        <td>{{n-a (format-date-fns document.created_at "yyyy-MM-dd")}}</td>
                        <td>
                            <div class="portal-table-actions justify-end">
                                {{#if document.url}}
                                    <div class="flex items-center justify-end space-x-2">
                                        <span class="btn-wrapper inline-flex rounded-md shadow-sm">
                                            <a href={{document.url}} target="_blank" rel="noopener noreferrer" class="btn btn-default btn-xs"><FaIcon @icon="eye" /></a>
                                        </span>
                                        <Button @size="xs" @icon="download" @onClick={{fn this.downloadDocument document}} />
                                    </div>
                                {{else}}
                                    <span class="text-xs text-gray-500">{{t "portal.documents.unavailable"}}</span>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="5">
                            <div class="portal-empty-state portal-table-empty-state">
                                <div class="portal-empty-state-icon"><FaIcon @icon="folder-open" /></div>
                                <div class="portal-empty-state-title">{{t "portal.documents.empty-title"}}</div>
                                <p>{{t "portal.documents.empty-desc"}}</p>
                            </div>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</Portal::ContentWrapper>

