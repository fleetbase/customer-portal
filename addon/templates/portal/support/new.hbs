<Portal::ContentWrapper class="portal-page-card">
    <div class="portal-section-header">
        <div>
            <div class="portal-section-eyebrow">{{t "portal.support.eyebrow"}}</div>
            <h1>{{t "portal.support.new-ticket"}}</h1>
            <p>{{t "portal.support.form.subtitle"}}</p>
        </div>
        <LinkTo @route="portal.support" class="portal-quick-link">
            <FaIcon @icon="arrow-left" />
            <span>{{t "portal.support.back-to-support"}}</span>
        </LinkTo>
    </div>

    <form {{on "submit" (perform this.createTicket)}} class="portal-form-stack portal-form-surface">
        <InputGroup @name={{t "portal.support.form.subject"}} @value={{this.title}} @placeholder={{t "portal.support.form.subject-placeholder"}} />
        <InputGroup @name={{t "portal.support.form.order"}} @helpText={{t "portal.support.form.order-help"}}>
            <PowerSelect
                @options={{this.model.orders}}
                @selected={{this.order}}
                @onChange={{fn (mut this.order)}}
                @placeholder={{t "portal.support.form.select-order"}}
                @triggerClass="form-select form-input"
                @allowClear={{true}}
                as |order|
            >
                {{or order.tracking_number.tracking_number order.public_id order.id}}
            </PowerSelect>
        </InputGroup>
        <InputGroup @name={{t "portal.support.form.category"}}>
            <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                <PowerSelect
                    @options={{this.customerIssueCategories}}
                    @selected={{this.selectedIssueCategory}}
                    @onChange={{this.setIssueCategory}}
                    @placeholder={{t "portal.support.form.select-category"}}
                    @triggerClass="form-select form-input"
                    @renderInPlace={{true}}
                    as |category|
                >
                    <div class="text-sm">
                        <div class="font-semibold normalize-in-trigger">{{category.label}}</div>
                        <div class="hide-from-trigger">{{category.description}}</div>
                    </div>
                </PowerSelect>
            </div>
        </InputGroup>
        <InputGroup @name={{t "portal.support.form.priority"}}>
            <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                <PowerSelect
                    @options={{this.issuePriorities}}
                    @selected={{this.selectedIssuePriority}}
                    @onChange={{this.setIssuePriority}}
                    @placeholder={{t "portal.support.form.select-priority"}}
                    @triggerClass="form-select form-input"
                    @renderInPlace={{true}}
                    as |priority|
                >
                    <div class="text-sm">
                        <div class="font-semibold normalize-in-trigger">{{priority.label}}</div>
                        <div class="hide-from-trigger">{{priority.description}}</div>
                    </div>
                </PowerSelect>
            </div>
        </InputGroup>
        <InputGroup @name={{t "portal.support.form.tags"}} @helpText={{t "portal.support.form.tags-help"}}>
            <TagInput class="form-input" @tags={{this.tags}} @addTag={{this.addTag}} @removeTagAtIndex={{this.removeTag}} @placeholder={{t "portal.support.form.add-tags"}} as |tag|>
                {{tag}}
            </TagInput>
        </InputGroup>
        <InputGroup @name={{t "portal.support.form.details"}}>
            <Textarea @value={{this.report}} class="form-input w-full" rows="6" placeholder={{t "portal.support.form.details-placeholder"}} />
        </InputGroup>
        <div class="portal-form-actions">
            <LinkTo @route="portal.support" class="portal-quick-link">
                <span>{{t "portal.orders.form.cancel"}}</span>
            </LinkTo>
            <Button @buttonType="submit" @type="primary" @icon="paper-plane" @text={{t "portal.support.create-ticket"}} @isLoading={{this.createTicket.isRunning}} />
        </div>
    </form>
</Portal::ContentWrapper>

