{
    "name": "@fleetbase/customer-portal-engine",
    "version": "0.0.13",
    "description": "Extendable Customer Portal for Fleetbase",
    "keywords": [
        "fleetbase-extension",
        "fleetbase",
        "ember-addon",
        "ember-engine",
        "customer",
        "customer portal",
        "customer management",
        "customer tracking",
        "customer support"
    ],
    "fleetbase": {
        "route": "customer-portal",
        "mount": "root"
    },
    "repository": "https://github.com/fleetbase/customer-portal",
    "license": "AGPL-3.0-or-later",
    "author": "Fleetbase Pte Ltd. <hello@fleetbase.io>",
    "directories": {
        "app": "app",
        "addon": "addon",
        "tests": "tests"
    },
    "scripts": {
        "build": "ember build --environment=production",
        "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
        "lint:css": "stylelint \"**/*.css\"",
        "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
        "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
        "lint:hbs": "ember-template-lint .",
        "lint:hbs:fix": "ember-template-lint . --fix",
        "lint:js": "eslint . --cache",
        "lint:js:fix": "eslint . --fix",
        "start": "ember serve",
        "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
        "test:ember": "ember test",
        "test:ember-compatibility": "ember try:each",
        "publish:npm": "npm config set registry https://registry.npmjs.org/ && npm publish",
        "publish:github": "npm config set '@fleetbase:registry' https://npm.pkg.github.com/ && npm publish"
    },
    "dependencies": {
        "@babel/core": "^7.25.2",
        "@fleetbase/ember-core": "^0.3.24",
        "@fleetbase/ember-ui": "^0.3.39",
        "@fleetbase/fleetops-data": "^0.1.36",
        "@fleetbase/leaflet-routing-machine": "^3.2.17",
        "@fortawesome/ember-fontawesome": "^2.0.0",
        "@fortawesome/fontawesome-svg-core": "6.4.0",
        "@fortawesome/free-brands-svg-icons": "6.4.0",
        "@fortawesome/free-solid-svg-icons": "6.4.0",
        "@stripe/connect-js": "^3.3.13",
        "broccoli-funnel": "^3.0.8",
        "broccoli-merge-trees": "^4.2.0",
        "ember-auto-import": "^2.7.4",
        "ember-cli-babel": "^8.2.0",
        "ember-cli-htmlbars": "^6.3.0",
        "ember-drag-sort": "^3.0.1",
        "ember-intl": "6.3.2",
        "ember-radio-button": "3.0.0-beta.1",
        "ember-wormhole": "^0.6.0"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.25.1",
        "@babel/plugin-proposal-decorators": "^7.24.7",
        "@ember/optional-features": "^2.1.0",
        "@ember/test-helpers": "^3.3.1",
        "@embroider/test-setup": "^3.0.3",
        "@glimmer/component": "^1.1.2",
        "@glimmer/tracking": "^1.1.2",
        "broccoli-asset-rev": "^3.0.0",
        "concurrently": "^8.2.2",
        "ember-cli": "~5.4.2",
        "ember-cli-clean-css": "^3.0.0",
        "ember-cli-dependency-checker": "^3.3.2",
        "ember-cli-inject-live-reload": "^2.1.0",
        "ember-cli-sri": "^2.1.1",
        "ember-cli-terser": "^4.0.2",
        "ember-composable-helpers": "^5.0.0",
        "ember-concurrency": "^4.0.6",
        "ember-data": "^4.12.8",
        "ember-engines": "^0.9.0",
        "ember-load-initializers": "^2.1.2",
        "ember-math-helpers": "^4.0.0",
        "ember-page-title": "^8.2.3",
        "ember-qunit": "^8.1.0",
        "ember-resolver": "^11.0.1",
        "ember-source": "~5.4.1",
        "ember-source-channel-url": "^3.0.0",
        "ember-template-lint": "^5.13.0",
        "ember-try": "^3.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-ember": "^11.12.0",
        "eslint-plugin-n": "^16.6.2",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-qunit": "^8.1.2",
        "loader.js": "^4.7.0",
        "prettier": "^3.3.3",
        "qunit": "^2.22.0",
        "qunit-dom": "^2.0.0",
        "resolve": "^1.22.8",
        "stylelint": "^15.11.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-prettier": "^4.1.0",
        "webpack": "^5.94.0"
    },
    "peerDependencies": {
        "ember-engines": "^0.9.0"
    },
    "engines": {
        "node": ">= 22"
    },
    "ember": {
        "edition": "octane"
    },
    "ember-addon": {
        "configPath": "tests/dummy/config"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "printWidth": 190,
        "overrides": [
            {
                "files": "*.hbs",
                "options": {
                    "singleQuote": false
                }
            }
        ]
    }
}
